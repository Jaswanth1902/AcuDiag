# AcuDiag Ken Round 3 Credentials Store (Template)
# Copy this file to credentials.env and fill in your values.

# 1. Pine Labs Agentic Platform (https://agenticorg.hackathon.pinelabs.com)
PINELABS_AGENTIC_EMAIL=your_email@example.com
PINELABS_ORG_NAME="Ken's case competition"
PINELABS_TENANT_ID=your_tenant_id_here
PINELABS_USER_ID=your_user_id_here
PINELABS_SESSION_COOKIE="your_session_cookie_jwt_here"
PINELABS_CSRF_TOKEN="your_csrf_token_here"

# 2. Gnani.ai Voice Platform (https://app.gnani.ai)
GNANI_ACCOUNT_EMAIL=your_email@example.com
GNANI_API_KEY=your_gnani_api_key
GNANI_TOKEN=your_gnani_token
GNANI_APP_ID=your_gnani_app_id

# 3. Delhivery Sandbox / Mock Server
DELHIVERY_CLIENT_ID=your_delhivery_client_id
DELHIVERY_API_KEY=your_delhivery_api_key
DELHIVERY_MOCK_BASE_URL=http://localhost:8000

# 4. External Rails (WhatsApp / Telegram / Gmail)
TELEGRAM_BOT_TOKEN=
USER_PHONE_NUMBER=
AGENT_GMAIL_ADDRESS=
